#!/usr/bin/with-contenv bashio

set -e

CONFIG_DIR="/config/reticulum"
CONFIG_FILE="${CONFIG_DIR}/config"

mkdir -p "${CONFIG_DIR}"

# Home Assistant options.
# During standalone Docker development no Supervisor API exists,
# therefore use safe defaults.

AUTO_INTERFACE="$(bashio::config 'auto_interface' 2>/dev/null || true)"
INTERNET_BOOTSTRAP="$(bashio::config 'internet_bootstrap' 2>/dev/null || true)"
INTERFACE_DISCOVERY="$(bashio::config 'interface_discovery' 2>/dev/null || true)"
TCP_INTERFACE="$(bashio::config 'tcp_interface' 2>/dev/null || true)"
TCP_HOST="$(bashio::config 'tcp_host' 2>/dev/null || true)"
TCP_PORT="$(bashio::config 'tcp_port' 2>/dev/null || true)"
RNODE_INTERFACE="$(bashio::config 'rnode_interface' 2>/dev/null || true)"
RNODE_PORT="$(bashio::config 'rnode_port' 2>/dev/null || true)"
RNODE_FREQUENCY="$(bashio::config 'rnode_frequency' 2>/dev/null || true)"
RNODE_BANDWIDTH="$(bashio::config 'rnode_bandwidth' 2>/dev/null || true)"
RNODE_TXPOWER="$(bashio::config 'rnode_txpower' 2>/dev/null || true)"
RNODE_SF="$(bashio::config 'rnode_spreadingfactor' 2>/dev/null || true)"
RNODE_CR="$(bashio::config 'rnode_codingrate' 2>/dev/null || true)"
TRANSPORT="$(bashio::config 'transport' 2>/dev/null || true)"
LOGLEVEL="$(bashio::config 'loglevel' 2>/dev/null || true)"

[ -n "${AUTO_INTERFACE}" ] || AUTO_INTERFACE="true"
[ -n "${INTERNET_BOOTSTRAP}" ] || INTERNET_BOOTSTRAP="true"
[ -n "${INTERFACE_DISCOVERY}" ] || INTERFACE_DISCOVERY="true"
[ -n "${TCP_INTERFACE}" ] || TCP_INTERFACE="false"
[ -n "${TCP_PORT}" ] || TCP_PORT="4242"
[ -n "${RNODE_INTERFACE}" ] || RNODE_INTERFACE="false"
[ -n "${TRANSPORT}" ] || TRANSPORT="false"
[ -n "${LOGLEVEL}" ] || LOGLEVEL="info"

case "${LOGLEVEL}" in
    error)   RNS_LOGLEVEL=1 ;;
    warning) RNS_LOGLEVEL=2 ;;
    notice)  RNS_LOGLEVEL=3 ;;
    info)    RNS_LOGLEVEL=4 ;;
    verbose) RNS_LOGLEVEL=5 ;;
    debug)   RNS_LOGLEVEL=6 ;;
    path)    RNS_LOGLEVEL=7 ;;
    extreme) RNS_LOGLEVEL=8 ;;
    *)       RNS_LOGLEVEL=4 ;;
esac

if bashio::var.true "${TRANSPORT}"; then
    RNS_TRANSPORT="Yes"
else
    RNS_TRANSPORT="No"
fi

if bashio::var.true "${AUTO_INTERFACE}"; then
    RNS_AUTO="Yes"
else
    RNS_AUTO="No"
fi

if bashio::var.true "${INTERFACE_DISCOVERY}"; then
    RNS_DISCOVERY="Yes"
else
    RNS_DISCOVERY="No"
fi

bashio::log.info "Reticulum Network Stack"
bashio::log.info "AutoInterface: ${AUTO_INTERFACE}"
bashio::log.info "Internet bootstrap: ${INTERNET_BOOTSTRAP}"
bashio::log.info "Interface discovery: ${INTERFACE_DISCOVERY}"
bashio::log.info "Transport: ${TRANSPORT}"
bashio::log.info "Log level: ${LOGLEVEL} (${RNS_LOGLEVEL})"

# Create config only if it doesn't already exist.
# This preserves manual Reticulum configuration.
if [ ! -f "${CONFIG_FILE}" ]; then

    bashio::log.info "Creating initial Reticulum configuration"

    cat > "${CONFIG_FILE}" <<CONFIG
[reticulum]

  enable_transport = ${RNS_TRANSPORT}
  discover_interfaces = ${RNS_DISCOVERY}
  share_instance = Yes
  instance_name = reticulum_dev


[logging]

  loglevel = ${RNS_LOGLEVEL}


[interfaces]

  [[Home Assistant AutoInterface]]
    type = AutoInterface
    enabled = ${RNS_AUTO}
CONFIG

    if bashio::var.true "${TCP_INTERFACE}" && [ -n "${TCP_HOST}" ]; then
        bashio::log.info "Adding TCPClientInterface: ${TCP_HOST}:${TCP_PORT}"

        cat >> "${CONFIG_FILE}" <<CONFIG

  # BEGIN HOMEASSISTANT RETICULUM MANAGED TCP
  [[Home Assistant TCP Client]]
    type = TCPClientInterface
    enabled = Yes
    target_host = ${TCP_HOST}
    target_port = ${TCP_PORT}
  # END HOMEASSISTANT RETICULUM MANAGED TCP
CONFIG
    fi

else
    bashio::log.info "Using existing Reticulum configuration"

    # Remove only the TCP block managed by this add-on.
    sed -i '/# BEGIN HOMEASSISTANT RETICULUM MANAGED TCP/,/# END HOMEASSISTANT RETICULUM MANAGED TCP/d' "${CONFIG_FILE}"

    # Recreate it from the current Home Assistant options.
    if bashio::var.true "${TCP_INTERFACE}" && [ -n "${TCP_HOST}" ]; then
        bashio::log.info "Updating TCPClientInterface: ${TCP_HOST}:${TCP_PORT}"

        cat >> "${CONFIG_FILE}" <<CONFIG

  # BEGIN HOMEASSISTANT RETICULUM MANAGED TCP
  [[Home Assistant TCP Client]]
    type = TCPClientInterface
    enabled = Yes
    target_host = ${TCP_HOST}
    target_port = ${TCP_PORT}
  # END HOMEASSISTANT RETICULUM MANAGED TCP
CONFIG
    fi
fi


# Manage Reticulum interface discovery.
if grep -q '^[[:space:]]*discover_interfaces[[:space:]]*=' "${CONFIG_FILE}"; then
    sed -i "s/^[[:space:]]*discover_interfaces[[:space:]]*=.*/  discover_interfaces = ${RNS_DISCOVERY}/" "${CONFIG_FILE}"
else
    sed -i "/^\[reticulum\]/a\\
  discover_interfaces = ${RNS_DISCOVERY}" "${CONFIG_FILE}"
fi

# Manage the public Internet bootstrap independently.
sed -i '/# BEGIN HOMEASSISTANT RETICULUM INTERNET BOOTSTRAP/,/# END HOMEASSISTANT RETICULUM INTERNET BOOTSTRAP/d' "${CONFIG_FILE}"

if bashio::var.true "${INTERNET_BOOTSTRAP}"; then
    bashio::log.info "Internet bootstrap: sideband.connect.reticulum.network:7822"

    cat >> "${CONFIG_FILE}" <<CONFIG

  # BEGIN HOMEASSISTANT RETICULUM INTERNET BOOTSTRAP
  [[Home Assistant Internet Bootstrap]]
    type = BackboneInterface
    enabled = Yes
    remote = sideband.connect.reticulum.network
    target_port = 7822
    transport_identity = 521c87a83afb8f29e4455e77930b973b
  # END HOMEASSISTANT RETICULUM INTERNET BOOTSTRAP
CONFIG
fi

# Manage the RNode block independently from manual configuration.
sed -i '/# BEGIN HOMEASSISTANT RETICULUM MANAGED RNODE/,/# END HOMEASSISTANT RETICULUM MANAGED RNODE/d' "${CONFIG_FILE}"

if bashio::var.true "${RNODE_INTERFACE}"; then

    # Never auto-select a serial device.
    # The user must explicitly configure an existing local serial port.
    if [ -z "${RNODE_PORT}" ]; then
        bashio::log.error "RNode enabled but no serial port is configured"
        bashio::log.error "RNodeInterface will NOT be created"

    elif [[ "${RNODE_PORT}" != /dev/* ]] || [ ! -c "${RNODE_PORT}" ]; then
        bashio::log.error "Configured RNode port is not an accessible serial device: ${RNODE_PORT}"
        bashio::log.error "RNodeInterface will NOT be created"

    elif [ "${RNODE_FREQUENCY:-0}" -le 0 ]; then
        bashio::log.error "RNode enabled but frequency is invalid"
        bashio::log.error "RNodeInterface will NOT be created"

    else
        bashio::log.info "RNode configuration validated"
        bashio::log.info "RNode port: ${RNODE_PORT}"
        bashio::log.info "RNode frequency: ${RNODE_FREQUENCY}"
        bashio::log.info "RNode bandwidth: ${RNODE_BANDWIDTH}"
        bashio::log.info "RNode TX power: ${RNODE_TXPOWER}"
        bashio::log.info "RNode SF: ${RNODE_SF}"
        bashio::log.info "RNode CR: ${RNODE_CR}"

    cat >> "${CONFIG_FILE}" <<CONFIG

  # BEGIN HOMEASSISTANT RETICULUM MANAGED RNODE
  [[Home Assistant RNode]]
    type = RNodeInterface
    enabled = Yes
    port = ${RNODE_PORT}
    frequency = ${RNODE_FREQUENCY}
    bandwidth = ${RNODE_BANDWIDTH}
    txpower = ${RNODE_TXPOWER}
    spreadingfactor = ${RNODE_SF}
    codingrate = ${RNODE_CR}
  # END HOMEASSISTANT RETICULUM MANAGED RNODE
CONFIG
    fi
fi

if ! command -v rnsd >/dev/null 2>&1; then
    bashio::log.fatal "rnsd executable not found"
    exit 1
fi

bashio::log.info "Starting rnsd"

exec rnsd --config "${CONFIG_DIR}"
